TOKEN=

# Postgres (preferred)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Railway Storage Bucket (S3) — provision a dedicated Sir-5rM8 state bucket.
# Add Variable References from that bucket to the Sir-5rM8 service. Do not reuse
# ALICE's credentials. Objects use cache/ and state/ prefixes.
STORAGE_ENDPOINT=https://storage.railway.app
STORAGE_REGION=auto
# STORAGE_FORCE_PATH_STYLE=1
# STATE_BUCKET=${{bot-state.BUCKET}}
# STATE_ACCESS_KEY_ID=${{bot-state.ACCESS_KEY_ID}}
# STATE_SECRET_ACCESS_KEY=${{bot-state.SECRET_ACCESS_KEY}}
STATE_BUCKET=
STATE_ACCESS_KEY_ID=
STATE_SECRET_ACCESS_KEY=
# How often to rewrite the official list object when the size is unchanged (seconds)
# ASA_BUCKET_FLUSH_SECONDS=300

# Database-cache stale-while-revalidate timing (seconds). Persisted values may
# serve during the 10–30 second startup grace; verification never blocks ready.
# JSON_CACHE_STARTUP_GRACE_SECONDS=10
# JSON_CACHE_STARTUP_JITTER_SECONDS=20
# JSON_CACHE_RECONCILE_SECONDS=3600
# JSON_CACHE_BUCKET_SNAPSHOT_SECONDS=60

# Twitch go-live alerts (required to poll Twitch; configure the rest with /streamers setup)
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_CHANNELS=
# TWITCH_DISCORD_CHANNEL_ID=
# TWITCH_PING_ROLE_ID=
# TWITCH_POLL_INTERVAL_MINUTES=10
