TOKEN=

# Postgres (preferred)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Railway Storage Bucket (S3) — share ALICE's bot-state bucket (ASA cache + sticky ids)
# On the Sir-5rM8 service, add Variable References from the same bot-state bucket
# ALICE uses (do not inject a second AWS SDK preset — those keys clash with STATE_*).
STORAGE_ENDPOINT=https://storage.railway.app
STORAGE_REGION=auto
# STORAGE_FORCE_PATH_STYLE=1
# STATE_BUCKET=${{bot-state.BUCKET}}
# STATE_ACCESS_KEY_ID=${{bot-state.ACCESS_KEY_ID}}
# STATE_SECRET_ACCESS_KEY=${{bot-state.SECRET_ACCESS_KEY}}
STATE_BUCKET=
STATE_ACCESS_KEY_ID=
STATE_SECRET_ACCESS_KEY=
# How often to rewrite the official list object when the size is unchanged (seconds)
# ASA_BUCKET_FLUSH_SECONDS=300
